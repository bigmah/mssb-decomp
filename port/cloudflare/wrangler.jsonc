// The web build and online play's signaling on Cloudflare (see src/worker.js). Deploy with
// port/tools/deploy_cloudflare.sh, which stages the web build into build/cf-assets first.
{
  "name": "mssb",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../build/cf-assets",
    "binding": "ASSETS",
    // The disc chunks must go through the Worker's password check.
    "run_worker_first": ["/disc/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed classes are the ones the Workers Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
